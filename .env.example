PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Use `public` for the zero-friction assignment demo. Use `api-key` for private deployments.
API_ACCESS_MODE=public
API_KEYS=
REQUESTS_PER_MINUTE=2

# Preferred authentication: copy these from a browser session you own.
# Never commit real values. JSESSIONID may include quotes; keep them.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Alternative: a one-line Playwright storage-state JSON object.
LINKEDIN_STORAGE_STATE_JSON=

# Local-only alternative: path created by `playwright codegen --save-storage`.
LINKEDIN_STORAGE_STATE_PATH=

# Optional read-only seed file. A writable PATH takes precedence once created.
LINKEDIN_STORAGE_STATE_SEED_PATH=

# Guest mode only returns information LinkedIn exposes without signing in.
ALLOW_GUEST_MODE=false
INCLUDE_DETAIL_PAGES=true
SCRAPE_TIMEOUT_MS=45000
SCRAPE_CONCURRENCY=1
PROFILE_CACHE_TTL_SECONDS=900
MAX_CACHE_ENTRIES=250
LOG_LEVEL=info
