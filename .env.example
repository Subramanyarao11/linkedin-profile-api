PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Use `public` for the zero-friction assignment demo. Use `api-key` for private deployments.
API_ACCESS_MODE=public
API_KEYS=
REQUESTS_PER_MINUTE=2

# Authentication: copy these from a LinkedIn session you own.
# Never commit real values. JSESSIONID may include quotes; keep them.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Protects GET /ready. Generate with: openssl rand -hex 32
READINESS_KEY=
READINESS_CACHE_TTL_SECONDS=300
READINESS_TIMEOUT_MS=5000

# Optional immediate email alert. For Gmail, use an App Password rather than your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SESSION_ALERT_EMAIL_FROM=
SESSION_ALERT_EMAIL_TO=
SESSION_ALERT_COOLDOWN_SECONDS=3600
SERVICE_PUBLIC_URL=

INCLUDE_DETAIL_PAGES=true
SCRAPE_TIMEOUT_MS=45000
SCRAPE_CONCURRENCY=1
PROFILE_CACHE_TTL_SECONDS=900
MAX_CACHE_ENTRIES=250
LOG_LEVEL=info
